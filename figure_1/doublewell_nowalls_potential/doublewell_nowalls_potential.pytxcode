import sys
sys.path.append("E:/MSc files/Research/mpemba_functions/")

import mpemba
import sympy as sym
x = sym.symbols('x')
min_extent=-2
max_extent=+3
max_y_extent=130
line_extensions=0.5
potential = mpemba.special_potentials.AsymmetricDoubleWellPotential(E_barrier=10, E_tilt=5, x_well=1, force_asymmetry=0.3)
lower_well_y = potential.U(potential.x_well)
upper_well_y = potential.U(-potential.x_well)

print(fr"\addplot[domain={potential.x_l}:{potential.x_r}, samples=200]{{{potential.U_0(x)}}};".replace("**", "^"))
print(fr"\addplot[domain={min_extent}:{potential.x_l}, black]{{{potential.U_0(potential.x_l)-potential.F_left*(x-potential.x_l)}}};")
print(fr"\addplot[domain={potential.x_r}:{max_extent}, black]{{{potential.U_0(potential.x_r)+potential.F_right*(x-potential.x_r)}}};")
print(fr"\addplot[domain={min_extent-line_extensions}:{min_extent}, black, dashed]{{{potential.U_0(potential.x_l)-potential.F_left*(x-potential.x_l)}}};")
print(fr"\addplot[domain={max_extent}:{max_extent+line_extensions}, black, dashed]{{{potential.U_0(potential.x_r)+potential.F_right*(x-potential.x_r)}}};")

